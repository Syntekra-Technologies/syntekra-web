# Copy the values you need into .env.local (development) or .env.production.local / CI variables.
# All of these are embedded into the public bundle. Never put secrets here.

# Canonical site origin, without trailing slash.
VITE_SITE_URL=

# Public contact email shown in the contact section and footer. Leave empty to hide.
VITE_CONTACT_EMAIL=

# Endpoint that receives the contact form as a JSON POST:
#   { "name": "", "email": "", "company": "", "topic": "", "message": "" }
# Any 2xx response is treated as success. Leave empty to hide the form.
VITE_CONTACT_FORM_ENDPOINT=

# Show the client portal link in the navigation once app.syntekra.com is live.
VITE_CLIENT_PORTAL_ENABLED=
VITE_CLIENT_PORTAL_URL=
